#!/bin/sh
# Generated by genrt xtask from the canonical QEMU configuration.
set -eu

usage() {
    printf '%s\n' 'Usage: run.sh [-c N | --cpus N] [-h | --help]' \
        '  -c N, --cpus N  Virtual CPUs: 1..@MAX_CPUS@ (default: 1)' \
        '  -h, --help      Show this help without launching QEMU' \
        'Selects the matching packaged DTB. No QEMU arguments are forwarded.'
}

fail() {
    printf 'run.sh: %s\n' "$1" >&2
    exit 2
}

cpus=1
seen_cpus=0
help=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -c|--cpus)
            [ "$seen_cpus" -eq 0 ] || fail 'CPU count specified more than once'
            [ "$#" -ge 2 ] || fail 'missing CPU count after -c/--cpus'
            case "$2" in
                @CPU_VALUES@) cpus=$2 ;;
                *) fail 'CPU count must be an integer from 1 to @MAX_CPUS@' ;;
            esac
            seen_cpus=1
            shift 2
            ;;
        -h|--help) help=1; shift ;;
        *) fail "unknown argument: $1 (use --help)" ;;
    esac
done
if [ "$help" -eq 1 ]; then
    usage
    exit 0
fi

# Change only this process's cwd. Relative loader filenames also avoid QEMU's
# comma-separated device parser interpreting commas in the extraction path.
case "$0" in
    */*) script_dir=${0%/*}; script_dir=${script_dir:-/} ;;
    *) script_dir=. ;;
esac
CDPATH= cd -P -- "$script_dir" || fail 'cannot enter release directory'

# Each branch is rendered from qemu::Config, not a separate set of QEMU flags.
case "$cpus" in
@COMMANDS@
esac
for artifact in genrt-aarch64.elf initramfs.cpio "$dtb"; do
    [ -f "$artifact" ] && [ -r "$artifact" ] && [ -s "$artifact" ] \
        || fail "missing, empty, or unreadable artifact: $artifact"
done
command -v qemu-system-aarch64 >/dev/null 2>&1 || {
    printf '%s\n' 'run.sh: qemu-system-aarch64 not found in PATH; install QEMU' >&2
    exit 127
}
exec "$@"
